---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import BeckettFlowPreview from "../../components/BeckettFlowPreview.astro";
import BeckettArchDiagram from "../../components/diagrams/BeckettArchDiagram.astro";
import { loadCopy } from "../../lib/copy";

const { data, sections } = await loadCopy("copy-beckett-diligence");
if (!data.disclaimer) throw new Error("content/copy-beckett-diligence.md needs its disclaimer");

const html = {
  intro: sections.get("intro"),
  role: sections.get("my-role"),
  how: sections.get("how-it-works"),
  evaluation: sections.get("evaluation"),
};
sections.assertAllUsed();
---

<BaseLayout title={data.title} description={data.description}>
  <article class="space-y-10">
    <header class="max-w-3xl space-y-4">
      <p class="font-mono text-xs uppercase tracking-wider text-editorial-accent">Case study</p>
      <h1 class="text-3xl font-semibold tracking-tight">Beckett deal-diligence platform</h1>
      <Prose html={html.intro} />
      <p class="text-xs italic text-editorial-muted">{data.disclaimer}</p>
    </header>

    <BeckettFlowPreview />
    <BeckettArchDiagram />

    <section class="max-w-3xl space-y-10">
      <Prose html={html.how} />
      <Prose html={html.role} />
      <Prose html={html.evaluation} />
    </section>
  </article>
</BaseLayout>
