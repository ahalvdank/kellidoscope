---
// 4-column architecture diagram for 10-K KB (Desktop horizontal + Mobile stacked)
---

<figure class="my-8 rounded-lg border border-editorial-border bg-white p-4">
  <figcaption class="mb-3 flex flex-wrap items-center justify-between gap-2 text-xs text-editorial-muted">
    <span class="font-semibold text-editorial-ink">10-K Knowledge Base Architecture</span>
    <span class="flex items-center gap-3 font-mono text-[11px]">
      <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-slate-200 border border-slate-400"></span> Deterministic</span>
      <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-indigo-100 border border-indigo-400"></span> AI / ML</span>
      <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-emerald-100 border border-emerald-500"></span> Verification / Human</span>
    </span>
  </figcaption>

  <!-- Desktop Horizontal SVG -->
  <svg viewBox="0 0 920 260" class="hidden w-full sm:block" role="img" aria-label="10-K Knowledge Base 4-column architecture">
    <defs>
      <marker id="arrow-10k" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#64748b" />
      </marker>
    </defs>

    <!-- Column Headers -->
    <text x="105" y="20" text-anchor="middle" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">1. INGESTION</text>
    <text x="335" y="20" text-anchor="middle" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">2. AI / EXTRACTION</text>
    <text x="575" y="20" text-anchor="middle" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">3. STORAGE &amp; GRAPH</text>
    <text x="805" y="20" text-anchor="middle" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">4. VERIFICATION &amp; UI</text>

    <!-- Col 1 -->
    <rect x="15" y="40" width="180" height="72" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="105" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#0f172a">SEC Filing Parser</text>
    <text x="105" y="84" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">973 filings · 186 cos</text>
    <text x="105" y="99" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">Section detection</text>

    <rect x="15" y="140" width="180" height="72" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="105" y="166" text-anchor="middle" font-size="12" font-weight="600" fill="#0f172a">Sentence Chunker</text>
    <text x="105" y="184" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">394,913 chunks</text>
    <text x="105" y="199" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">Filing + section provenance</text>

    <!-- Col 2 -->
    <rect x="245" y="40" width="180" height="72" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="335" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#1e1b4b">Embeddings</text>
    <text x="335" y="84" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Qwen3-Embedding-0.6B</text>
    <text x="335" y="99" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">YoY tone drift (shadow)</text>

    <rect x="245" y="140" width="180" height="72" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="335" y="166" text-anchor="middle" font-size="12" font-weight="600" fill="#1e1b4b">Claim Extraction</text>
    <text x="335" y="184" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Claude · closed vocab</text>
    <text x="335" y="199" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">FinBERT + LLM diff (shadow)</text>

    <!-- Col 3 -->
    <rect x="485" y="40" width="180" height="72" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="575" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#0f172a">Vector Store</text>
    <text x="575" y="84" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">ChromaDB</text>
    <text x="575" y="99" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">Semantic top-k search</text>

    <rect x="485" y="140" width="180" height="72" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="575" y="166" text-anchor="middle" font-size="12" font-weight="600" fill="#0f172a">Bitemporal Graph</text>
    <text x="575" y="184" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">45.8K entities · 70.5K edges</text>
    <text x="575" y="199" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">40.9K claims · decay</text>

    <!-- Col 4 -->
    <rect x="715" y="40" width="190" height="72" rx="6" fill="#ecfdf5" stroke="#10b981" />
    <text x="810" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#064e3b">Manual Review Queue</text>
    <text x="810" y="84" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#065f46">Ticker/CIK + fuzzy link</text>
    <text x="810" y="99" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#065f46">Ambiguous match queue</text>

    <rect x="715" y="140" width="190" height="72" rx="6" fill="#ecfdf5" stroke="#10b981" />
    <text x="810" y="166" text-anchor="middle" font-size="12" font-weight="600" fill="#064e3b">Explorer &amp; Agent Skills</text>
    <text x="810" y="184" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#065f46">FastAPI + React UI</text>
    <text x="810" y="199" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#065f46">Static Query Traces</text>

    <!-- Arrows -->
    <line x1="105" y1="112" x2="105" y2="136" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-10k)" />
    <line x1="195" y1="165" x2="241" y2="85" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-10k)" />
    <line x1="195" y1="176" x2="241" y2="176" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-10k)" />
    <line x1="425" y1="76" x2="481" y2="76" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-10k)" />
    <line x1="425" y1="176" x2="481" y2="176" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-10k)" />
    <line x1="665" y1="160" x2="711" y2="85" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-10k)" />
    <line x1="665" y1="76" x2="711" y2="165" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-10k)" />
    <line x1="665" y1="176" x2="711" y2="176" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-10k)" />
  </svg>

  <!-- Mobile Stacked SVG -->
  <svg viewBox="0 0 340 460" class="block w-full sm:hidden" role="img" aria-label="10-K Knowledge Base mobile architecture">
    <rect x="10" y="10" width="320" height="88" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="24" y="34" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">1. INGESTION (DETERMINISTIC)</text>
    <text x="24" y="56" font-size="13" font-weight="600" fill="#0f172a">SEC Parser + Sentence Chunker</text>
    <text x="24" y="76" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">973 filings · 394,913 chunks · provenance</text>

    <rect x="10" y="122" width="320" height="88" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="24" y="146" font-size="11" font-family="JetBrains Mono, monospace" fill="#3730a3">2. AI / EXTRACTION</text>
    <text x="24" y="168" font-size="13" font-weight="600" fill="#1e1b4b">Qwen3 Embeddings + Claude Claims</text>
    <text x="24" y="188" font-size="11" font-family="JetBrains Mono, monospace" fill="#3730a3">Closed vocab · Shadow tone/FinBERT diff</text>

    <rect x="10" y="234" width="320" height="88" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="24" y="258" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">3. STORAGE &amp; GRAPH</text>
    <text x="24" y="280" font-size="13" font-weight="600" fill="#0f172a">ChromaDB + Bitemporal Graph</text>
    <text x="24" y="300" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">45.8K entities · 70.5K edges · 40.9K claims</text>

    <rect x="10" y="346" width="320" height="88" rx="6" fill="#ecfdf5" stroke="#10b981" />
    <text x="24" y="370" font-size="11" font-family="JetBrains Mono, monospace" fill="#065f46">4. VERIFICATION &amp; UI</text>
    <text x="24" y="392" font-size="13" font-weight="600" fill="#064e3b">Manual Review + Explorer / Traces</text>
    <text x="24" y="412" font-size="11" font-family="JetBrains Mono, monospace" fill="#065f46">Ambiguous link queue · FastAPI + React</text>
  </svg>
</figure>
