---
import { publicAssetExists } from "../lib/assets";
import { isExternal, resolveHref } from "../lib/links";

interface Props {
  name: string;
  summary: string;
  metric?: string;
  thumbnail?: string | null;
  thumbnailAlt?: string;
  status?: string;
  links: { label: string; href: string; event?: "repo" }[];
  size?: "flagship" | "secondary";
}
const { name, summary, metric, thumbnail, thumbnailAlt = "", status, links, size = "flagship" } = Astro.props;
const resolved = links.map((link) => ({ ...link, url: resolveHref(link.href) }));
const showThumbnail = publicAssetExists(thumbnail);

const BUTTON = "rounded-md bg-editorial-accent px-3 py-1.5 text-white hover:opacity-90";
const TEXT_LINK = "text-editorial-accent hover:underline";
---

<article
  class="flex h-full flex-col overflow-hidden rounded-lg border border-editorial-border bg-white transition hover:border-slate-400 hover:shadow-sm"
>
  {
    showThumbnail && (
      <img src={thumbnail} alt={thumbnailAlt} loading="lazy" class="aspect-video w-full border-b border-editorial-border object-cover" />
    )
  }
  <div class="flex flex-1 flex-col p-5">
    {metric && <p class="font-mono text-sm font-semibold text-editorial-ink">{metric}</p>}
    <h3 class={`${metric ? "mt-2 " : ""}${size === "flagship" ? "text-lg font-semibold tracking-tight" : "text-base font-semibold tracking-tight"}`}>
      {name}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-editorial-ink">{summary}</p>
    {status && <p class="mt-3 font-mono text-xs text-emerald-800">{status}</p>}
    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-4 text-sm font-medium">
      {
        resolved.map((link, index) => {
          const cls = index === 0 ? BUTTON : TEXT_LINK;
          return isExternal(link.url) ? (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              data-goatcounter-click={link.event}
              class={cls}
            >
              {link.label} ↗
            </a>
          ) : (
            <a href={link.url} class={cls}>
              {link.label} →
            </a>
          );
        })
      }
    </div>
  </div>
</article>
