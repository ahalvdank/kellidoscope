---
// 4-column architecture diagram for Beckett Diligence Platform (Desktop + Mobile)
---

<figure class="my-8 rounded-lg border border-editorial-border bg-white p-4">
  <figcaption class="mb-3 flex flex-wrap items-center justify-between gap-2 text-xs text-editorial-muted">
    <span class="font-semibold text-editorial-ink">Beckett Deal-Diligence Platform Architecture</span>
    <span class="flex items-center gap-3 font-mono text-[11px]">
      <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-slate-200 border border-slate-400"></span> Deterministic</span>
      <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-indigo-100 border border-indigo-400"></span> AI / Agents</span>
      <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-emerald-100 border border-emerald-500"></span> Verification / Human</span>
    </span>
  </figcaption>

  <!-- Desktop Horizontal SVG -->
  <svg data-variant="desktop" viewBox="0 0 920 330" class="hidden w-full sm:block" role="img" aria-label="Beckett Diligence Platform 4-column architecture">
    <defs>
      <marker id="arrow-beckett" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#64748b" />
      </marker>
    </defs>

    <text x="105" y="20" text-anchor="middle" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">1. INGESTION</text>
    <text x="335" y="20" text-anchor="middle" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">2. RETRIEVAL &amp; STORAGE</text>
    <text x="575" y="20" text-anchor="middle" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">3. AGENT ORCHESTRATION</text>
    <text x="810" y="20" text-anchor="middle" font-size="11" font-family="JetBrains Mono, monospace" fill="#475569">4. COMMITTEE &amp; APPROVAL</text>

    <!-- Col 1 -->
    <rect x="15" y="40" width="180" height="72" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="105" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#0f172a">Deal &amp; Market Docs</text>
    <text x="105" y="84" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">Prior deals · Target docs</text>
    <text x="105" y="99" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">Licensed industry data</text>

    <rect x="15" y="140" width="180" height="72" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="105" y="166" text-anchor="middle" font-size="12" font-weight="600" fill="#0f172a">Table &amp; Parent Chunker</text>
    <text x="105" y="184" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">Whole tables preserved</text>
    <text x="105" y="199" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">500–700 tok · exact quotes</text>

    <!-- Col 2 -->
    <rect x="245" y="40" width="180" height="72" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="335" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#0f172a">Structured Fact Tables</text>
    <text x="335" y="84" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">SQL / JSON fact basis</text>
    <text x="335" y="99" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">Source, page, date</text>

    <rect x="245" y="140" width="180" height="72" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="335" y="166" text-anchor="middle" font-size="12" font-weight="600" fill="#1e1b4b">pgvector Embeddings</text>
    <text x="335" y="184" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">text-embedding-3-small</text>
    <text x="335" y="199" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Parent-child retrieval</text>

    <!-- Col 3 -->
    <rect x="485" y="40" width="180" height="72" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="575" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#1e1b4b">Python Orchestrator</text>
    <text x="575" y="84" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Idempotent · resumable</text>
    <text x="575" y="99" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Separate reasoning log</text>

    <rect x="485" y="140" width="180" height="72" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="575" y="166" text-anchor="middle" font-size="12" font-weight="600" fill="#1e1b4b">Specialist Agents</text>
    <text x="575" y="184" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Valuation · Section writers</text>
    <text x="575" y="199" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Judges · Critics</text>

    <!-- Col 4 -->
    <rect x="715" y="40" width="190" height="72" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="810" y="66" text-anchor="middle" font-size="12" font-weight="600" fill="#1e1b4b">Agent Committee</text>
    <text x="810" y="84" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Adversarial · Assoc · Partner</text>
    <text x="810" y="99" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Reviews the full package</text>

    <!-- Human gate: the only human step, kept in its own emerald box -->
    <rect x="715" y="140" width="190" height="72" rx="6" fill="#ecfdf5" stroke="#10b981" stroke-width="2" />
    <text x="810" y="166" text-anchor="middle" font-size="12" font-weight="600" fill="#064e3b">Human final quality gate</text>
    <text x="810" y="184" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#065f46">Final judge of models</text>
    <text x="810" y="199" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#065f46">and memos</text>

    <!-- Row 3 -->
    <rect x="485" y="240" width="180" height="72" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="575" y="266" text-anchor="middle" font-size="12" font-weight="600" fill="#1e1b4b">Retrospective Agent</text>
    <text x="575" y="284" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Reviews the reasoning</text>
    <text x="575" y="299" text-anchor="middle" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Lessons to memory</text>

    <!-- Arrows -->
    <line x1="105" y1="112" x2="105" y2="136" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
    <line x1="195" y1="165" x2="241" y2="85" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
    <line x1="195" y1="176" x2="241" y2="176" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
    <line x1="425" y1="76" x2="481" y2="165" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
    <line x1="425" y1="176" x2="481" y2="176" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
    <line x1="575" y1="112" x2="575" y2="136" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
    <line x1="665" y1="165" x2="711" y2="85" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
    <line x1="810" y1="112" x2="810" y2="136" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
    <line x1="575" y1="212" x2="575" y2="236" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett)" />
  </svg>

  <!-- Mobile Stacked SVG -->
  <svg data-variant="mobile" viewBox="0 0 340 570" class="block w-full sm:hidden" role="img" aria-label="Beckett Diligence Platform mobile architecture">
    <defs>
      <marker id="arrow-beckett-m" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#64748b" />
      </marker>
    </defs>
    <rect x="10" y="10" width="320" height="88" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="24" y="34" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">1. INGESTION</text>
    <text x="24" y="56" font-size="13" font-weight="600" fill="#0f172a">Deal Docs + Table/Parent Chunker</text>
    <text x="24" y="76" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">500–700 tok · whole tables</text>
    <text x="24" y="90" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">Exact provenance</text>

    <rect x="10" y="122" width="320" height="88" rx="6" fill="#f1f5f9" stroke="#94a3b8" />
    <text x="24" y="146" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">2. TWO-LAYER RETRIEVAL</text>
    <text x="24" y="168" font-size="13" font-weight="600" fill="#0f172a">SQL/JSON Facts + pgvector</text>
    <text x="24" y="188" font-size="10" font-family="JetBrains Mono, monospace" fill="#475569">text-embedding-3-small (~6× cheaper)</text>

    <rect x="10" y="234" width="320" height="88" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="24" y="258" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">3. AGENT ORCHESTRATION</text>
    <text x="24" y="280" font-size="13" font-weight="600" fill="#1e1b4b">Custom Python + Specialists</text>
    <text x="24" y="300" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Valuation · Drafters</text>
    <text x="24" y="314" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Judges · Critics</text>

    <rect x="10" y="346" width="320" height="88" rx="6" fill="#eef2ff" stroke="#6366f1" />
    <text x="24" y="370" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">4. AGENT COMMITTEE &amp; MEMORY</text>
    <text x="24" y="392" font-size="13" font-weight="600" fill="#1e1b4b">Committee + Retrospective Agent</text>
    <text x="24" y="412" font-size="10" font-family="JetBrains Mono, monospace" fill="#3730a3">Adversarial · Associate · Partner</text>

    <rect x="10" y="458" width="320" height="88" rx="6" fill="#ecfdf5" stroke="#10b981" stroke-width="2" />
    <text x="24" y="482" font-size="10" font-family="JetBrains Mono, monospace" fill="#065f46">5. HUMAN</text>
    <text x="24" y="504" font-size="13" font-weight="600" fill="#064e3b">Human final quality gate</text>
    <text x="24" y="524" font-size="10" font-family="JetBrains Mono, monospace" fill="#065f46">Final judge of models and memos</text>

    <!-- Connectors between stacked stages -->
    <line x1="170" y1="98" x2="170" y2="120" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett-m)" />
    <line x1="170" y1="210" x2="170" y2="232" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett-m)" />
    <line x1="170" y1="322" x2="170" y2="344" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett-m)" />
    <line x1="170" y1="434" x2="170" y2="456" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-beckett-m)" />
  </svg>
</figure>
