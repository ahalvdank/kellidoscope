---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TraceViewer from "../../../components/TraceViewer";
import { getManifest, getTrace, listFeaturedSlugs, loadAllTraces } from "../../../data/traces";

const traces = loadAllTraces();
const manifest = getManifest();
const [firstSlug] = listFeaturedSlugs();
if (!firstSlug) throw new Error("Manifest has no featured traces. Run `node scripts/sync-traces.mjs <SRC>`.");
const initialTrace = getTrace(firstSlug);
---

<BaseLayout
  title="10-K Knowledge Base — Query Traces | Andrew Kell"
  description="Deterministic replay of real SEC 10-K RAG and knowledge-graph pipeline runs with full provenance, rejected candidates, and extraction JSON."
  ogImage="/og-10k-demo.png"
  tier="workspace"
>
  <TraceViewer
    client:load
    manifest={manifest}
    initialTrace={initialTrace}
    allTraces={traces}
  />
</BaseLayout>
