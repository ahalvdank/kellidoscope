---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import TraceViewer from "../../../../components/TraceViewer";
import { getManifest, getTrace, listFeaturedSlugs } from "../../../../data/traces";
import type { Trace, TraceManifest } from "../../../../data/types";

export function getStaticPaths() {
  const manifest = getManifest();

  return listFeaturedSlugs().map((slug) => ({
    params: { slug },
    props: { trace: getTrace(slug), manifest },
  }));
}

interface Props {
  trace: Trace;
  manifest: TraceManifest;
}

const { trace, manifest } = Astro.props;
---

<BaseLayout
  title={`${trace.title} — 10-K Query Trace | Andrew Kell`}
  description={trace.question}
  ogImage="/og-10k-demo.png"
  tier="workspace"
>
  <TraceViewer
    client:load
    manifest={manifest}
    initialTrace={trace}
  />
</BaseLayout>
