---
import { siteConfig } from "../data/siteConfig";

interface Props {
  tier?: "editorial" | "workspace";
}
const { tier = "editorial" } = Astro.props;
const bgClass = tier === "workspace" ? "bg-workspace-surface" : "bg-editorial-bg/95";
---

<header class={`site-topbar sticky top-0 z-30 border-b border-editorial-border ${bgClass} backdrop-blur`}>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <div class="flex items-center gap-6">
      <a href="/" class="text-sm font-semibold tracking-tight text-editorial-ink hover:text-editorial-accent">
        Andrew Kell
      </a>
      <nav aria-label="Primary" class="hidden items-center gap-5 text-sm text-editorial-muted sm:flex">
        <a href="/projects/10k-kb" class="hover:text-editorial-ink">10-K KB</a>
        <a href="/projects/beckett-diligence" class="hover:text-editorial-ink">Beckett</a>
        <a href="/projects/portfolio-manager" class="hover:text-editorial-ink">Portfolio Manager</a>
        <a href="/demos/10k-kb" class="font-medium text-editorial-accent hover:underline">Query Traces</a>
      </nav>
    </div>

    <div class="flex items-center gap-3 text-xs sm:text-sm">
      <!-- Phone menu: native <details>, so it works with JavaScript off. Hidden from sm: up, where the inline nav shows. -->
      <details class="group sm:hidden">
        <summary
          class="cursor-pointer list-none rounded border border-editorial-border px-2.5 py-1 font-medium text-editorial-ink marker:hidden [&::-webkit-details-marker]:hidden"
        >
          Menu
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute inset-x-0 top-full flex flex-col border-b border-editorial-border bg-white px-4 py-2 text-sm shadow-md"
        >
          <a href="/projects/10k-kb" class="py-2 text-editorial-ink">10-K KB</a>
          <a href="/projects/beckett-diligence" class="py-2 text-editorial-ink">Beckett</a>
          <a href="/projects/portfolio-manager" class="py-2 text-editorial-ink">Portfolio Manager</a>
          <a href="/demos/10k-kb" class="py-2 font-medium text-editorial-accent">Query Traces</a>
          <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="py-2 text-editorial-muted">LinkedIn</a>
          <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" data-goatcounter-click="repo" class="py-2 text-editorial-muted">GitHub</a>
        </nav>
      </details>
      <a
        href={siteConfig.resumePath}
        target="_blank"
        rel="noopener noreferrer"
        data-goatcounter-click="resume"
        class="rounded border border-editorial-border bg-white px-2.5 py-1 font-medium text-editorial-ink hover:border-editorial-accent"
      >
        Résumé
      </a>
      <a
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-editorial-muted hover:text-editorial-ink sm:inline"
      >
        LinkedIn
      </a>
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
        data-goatcounter-click="repo"
        class="hidden text-editorial-muted hover:text-editorial-ink sm:inline"
      >
        GitHub
      </a>
    </div>
  </div>
</header>
