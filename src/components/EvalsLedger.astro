---
interface EvalRow {
  eval: string;
  tested: string;
  result: string;
}

const rows: EvalRow[] = [
  {
    eval: "Extraction model A/B (119 sections)",
    tested: "Private pipeline: Claude Sonnet 4.6 against Sonnet 5 on entity extraction",
    result: "Kept Sonnet 4.6. Sonnet 5 found 84% fewer company entities.",
  },
  {
    eval: "Open-model extraction benchmark",
    tested: "Private pipeline: open models from 7B to 70B on high-yield filing sections",
    result: "Rejected. The best reached about 48% recall, and one hallucinated facts.",
  },
  {
    eval: "Noise floor and cheaper effort setting",
    tested: "Private pipeline: the same model run against itself, as the bar for judging a cheaper setting",
    result: "The cheaper setting would cut cost per section about 56%, from $0.300 to $0.133. Not adopted.",
  },
  {
    eval: "Pipeline audit",
    tested: "Private pipeline: dropped entity links and empty filing-years",
    result: "Found 7 tickers with dropped entity links and 12 of 126 filing-years that were empty table-of-contents stubs. Both fixed to zero.",
  },
  {
    eval: "Section-text fidelity",
    tested: "Public sample: whether the public section detector produces the same text as the private pipeline",
    result: "681 of the 682 comparable sections match (99.9%). Coverage: only 682 of 824 sections could be compared (82.8%).",
  },
  {
    eval: "Per-sentence citation, number and scale checks",
    tested: "Public sample: every sentence cites a passage, and every number appears in a passage it cites, at the same scale",
    result: "12 traces, 0 problems. 8 of the 144 numbers appear in their passage without a scale, such as a table cell under an \"in millions\" header, and go to a human audit list.",
  },
  {
    eval: "SEC links",
    tested: "Public sample: each distinct SEC link in the traces is requested once",
    result: "19 of 19 returned HTTP 200.",
  },
  {
    eval: "Human audit",
    tested: "Public sample: my own review, on top of the automated checks",
    result: "13 questions run. One passed the automated checks but failed my review on three weak sentences and was dropped; 12 are exported.",
  },
];
---

<section class="my-10 space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-editorial-ink">Verification &amp; Evals Ledger</h2>
    <p class="mt-1 text-sm text-editorial-muted">
      Checks already run on the private pipeline and the public sample.
    </p>
  </div>

  <div class="overflow-x-auto rounded-lg border border-editorial-border bg-white">
    <table class="min-w-full border-collapse text-left text-sm">
      <thead class="border-b border-editorial-border bg-slate-50 font-mono text-xs text-editorial-muted">
        <tr>
          <th class="px-4 py-3">Eval</th>
          <th class="px-4 py-3">What it tested</th>
          <th class="px-4 py-3">Result</th>
          <th class="px-4 py-3">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-editorial-border">
        {rows.map((r) => (
          <tr>
            <td class="px-4 py-3 font-medium text-editorial-ink">{r.eval}</td>
            <td class="px-4 py-3 text-editorial-muted">{r.tested}</td>
            <td class="px-4 py-3 text-editorial-ink">{r.result}</td>
            <td class="px-4 py-3 font-mono text-xs">
              <span class="rounded bg-emerald-50 px-2 py-0.5 text-emerald-800 border border-emerald-200">
                Measured
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="text-sm text-editorial-muted">
    Planned for v2: retrieval recall@k, citation faithfulness, a claim-extraction audit, and cost per 10-K ingested. They get numbers when they are measured.
  </p>

  <!-- Failure Modes Caught -->
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="rounded-lg border border-amber-200 bg-amber-50/60 p-4">
      <p class="font-mono text-xs font-semibold uppercase text-amber-900">
        Failure Mode Caught #1 — Invalid Eval Control
      </p>
      <p class="mt-2 text-sm text-editorial-ink">
        A prompt revision, <code class="font-mono text-xs">v4b</code>, first looked like an improvement because it was scored against a control run on a <em>different</em> prompt. Rerunning the control on the same prompt reversed the conclusion: <code class="font-mono text-xs">v4b</code> made nearly every entity type worse (mean gap across types 3.2 vs. 1.8 for <code class="font-mono text-xs">v4a</code>) and caused extra timeouts. Rule adopted: never score a prompt change against a control on a different prompt.
      </p>
    </div>

    <div class="rounded-lg border border-amber-200 bg-amber-50/60 p-4">
      <p class="font-mono text-xs font-semibold uppercase text-amber-900">
        Failure Mode Caught #2 — Silent MD&amp;A Truncation
      </p>
      <p class="mt-2 text-sm text-editorial-ink">
        Long MD&amp;A sections (often 5–10K tokens, sometimes 20–60K) were silently truncated by the earlier embedding model's 8,192-token limit, dropping late portions where year-over-year changes often appear. Fix: sentence-boundary chunking of long sections.
      </p>
    </div>
  </div>
</section>
