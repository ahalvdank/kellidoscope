---
import { isExternal, resolveHref } from "../lib/links";

interface Props {
  name: string;
  summary: string;
  status?: string;
  links: { label: string; href: string; event?: "repo" }[];
  size?: "flagship" | "secondary";
}
const { name, summary, status, links, size = "flagship" } = Astro.props;
const resolved = links.map((link) => ({ ...link, url: resolveHref(link.href) }));
---

<article class="flex h-full flex-col rounded-lg border border-editorial-border bg-white p-5">
  <h3 class={size === "flagship" ? "text-lg font-semibold tracking-tight" : "text-base font-semibold tracking-tight"}>
    {name}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-editorial-ink">{summary}</p>
  {status && <p class="mt-3 font-mono text-xs text-emerald-800">{status}</p>}
  <div class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-4 text-sm font-medium">
    {
      resolved.map((link) =>
        isExternal(link.url) ? (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            data-goatcounter-click={link.event}
            class="text-editorial-accent hover:underline"
          >
            {link.label} ↗
          </a>
        ) : (
          <a href={link.url} class="text-editorial-accent hover:underline">
            {link.label} →
          </a>
        ),
      )
    }
  </div>
</article>
