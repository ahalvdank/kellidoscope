---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LiveFinding from "../components/LiveFinding.astro";
import { getTrace } from "../data/traces";
import { loadCopy } from "../lib/copy";
import { extractFinding, LIVE_FINDING } from "../lib/liveFinding";
import { resolveHref } from "../lib/links";
import { assertPublicAssets, resolveClip, resolvePreview } from "../lib/assets";

const { data, sections } = await loadCopy("copy-home");
const { hero, flagships, personal } = data;
if (!hero || !flagships || !personal) throw new Error("content/copy-home.md needs hero, flagships and personal");
sections.assertAllUsed();

// A card's preview and clip keys must be siteConfig *Preview / *Clip keys, and set paths must exist:
// all fail the build. A clip needs its caption, so a recording never ships unexplained.
const wineCards = personal.cards.map(({ preview, previewAlt, clip, clipCaption, ...card }) => {
  const recording = clip ? resolveClip(clip) : null;
  if (recording && !clipCaption) throw new Error(`Wine card "${card.name}" has a clip but no clipCaption`);
  return {
    ...card,
    thumbnail: preview ? resolvePreview(preview) : null,
    thumbnailAlt: previewAlt,
    recording: recording ? { ...recording, caption: clipCaption as string } : null,
  };
});
assertPublicAssets(...wineCards.flatMap((card) => [card.thumbnail, card.recording?.src ?? null, card.recording?.poster ?? null]));

const trace = getTrace(LIVE_FINDING.slug);
const finding = extractFinding(trace, LIVE_FINDING.needle);
const findingSource = "Live finding · NVIDIA 10-K, FY2022 → FY2026 trace";
---

<BaseLayout title={data.title} description={data.description}>
  <section class="grid items-start gap-8 md:grid-cols-2">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{hero.headline}</h1>
      <p class="mt-4 text-lg leading-relaxed text-editorial-muted">{hero.subhead}</p>
      <a
        href={resolveHref(hero.cta.href)}
        data-goatcounter-click="hero-cta"
        class="mt-6 inline-block rounded-md bg-editorial-accent px-5 py-3 text-base font-medium text-white hover:opacity-90"
      >
        {hero.cta.label} →
      </a>
    </div>
    <LiveFinding {...finding} source={findingSource} />
  </section>

  <section class="mt-10" aria-labelledby="systems">
    <h2 id="systems" class="sr-only">Systems</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {flagships.map((card) => <ProjectCard {...card} />)}
    </div>
  </section>

  <section id="wine-apps" class="mt-14 scroll-mt-20 sm:scroll-mt-24 [body:has(.site-topbar_details[open])_&]:scroll-mt-[22rem]" aria-labelledby="personal">
    <h2 id="personal" class="text-xl font-semibold tracking-tight">{personal.heading}</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {wineCards.map((card) => <ProjectCard {...card} size="secondary" />)}
    </div>
    <p class="mt-3 max-w-3xl text-xs text-editorial-muted">{personal.role}</p>
  </section>
</BaseLayout>
