---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import TopBar from "../components/TopBar.astro";
import { siteConfig } from "../data/siteConfig";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  tier?: "editorial" | "workspace";
}

const { title, description, ogImage, tier = "editorial" } = Astro.props;
const bodyBg = tier === "workspace" ? "bg-workspace-bg" : "bg-editorial-bg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <Seo title={title} description={description} ogImage={ogImage} />
    <script
      is:inline
      data-goatcounter={`${siteConfig.goatcounter}/count`}
      async
      src="https://gc.zgo.at/count.v5.js"
      crossorigin="anonymous"
      integrity="sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ"
    ></script>
  </head>
  <body class={`${bodyBg} text-editorial-ink`}>
    <TopBar tier={tier} />
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>
  </body>
</html>
